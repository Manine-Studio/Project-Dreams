%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_TempleArrival
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 84070235a19255a49b72bcc4bacfe7d6, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "<i><color=#34689c>[C'era un gran baccano, era chiaro come la
          gente del posto fosse particolarmente sconvolta dall'accaduto. Alcuni pi\xF9
          di altri.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6bee733369f5fe5458312581916ed882, type: 3}
    - _sName: ???
      _Sentences:
      - _sSentence: "\xC8 scomparso, Kerith! Sparito nel nulla! Oh, che la Dea abbia
          piet\xE0 di me, per l'amor del cielo\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 5e33ae8bec25315418f33ab1dd84b9e0, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 66518c072cad36846a95a41d6c52d75c, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6bee733369f5fe5458312581916ed882, type: 3}
    - _sName: ???
      _Sentences:
      - _sSentence: "Calmati, Uldon\u2026 Ecco, stringi questo, ti aiuter\xE0 a rilassare
          i nervi\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 635bf6c7278bd2c439b5b379321ed127, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ef45f4e96759189439f3d192169e2e2e, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6bee733369f5fe5458312581916ed882, type: 3}
    - _sName: ???
      _Sentences:
      - _sSentence: "Quindici generazioni\u2026 Quindici generazioni di monaci! Mio
          padre, il padre di mio padre e suo padre ancora prima di lui\u2026 Come
          far\xF2 ora Kerith? Come?!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 5e33ae8bec25315418f33ab1dd84b9e0, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 66518c072cad36846a95a41d6c52d75c, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6bee733369f5fe5458312581916ed882, type: 3}
    - _sName: ???
      _Sentences:
      - _sSentence: "Lo ritroveremo, Uldon. Non preoccuparti\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 635bf6c7278bd2c439b5b379321ed127, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ef45f4e96759189439f3d192169e2e2e, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6bee733369f5fe5458312581916ed882, type: 3}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "Detective, le presento Uldon e Kerith. Uldon \xE8 il monaco
          che si occupava del Cuscino della Dea prima della sua scomparsa; vive qui
          al Tempio ed \xE8 stato il primo a notare la sua assenza.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 923ec003d26e5544499dbf7672e2857e, type: 3}
        - {fileID: 0}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "Kerith \xE8 il nostro medico di fiducia. \xC8 un caro amico,
          stava aiutando Uldon con i suoi\u2026 Malori.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 923ec003d26e5544499dbf7672e2857e, type: 3}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Signori. Avrei preferito incontrarvi in circostanze pi\xF9 fortunate,
          ma \xE8 un piacere fare la vostra conoscenza. Detective Bakon\xE9, per
          servirvi.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 0fca24f27a7892946af3a287ce4b73ad, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: da59ace3bb8ca1d449cfd4ce10afc64c, type: 3}
        - {fileID: 0}
    - _sName: <color=#27d690>Kerith</color>
      _Sentences:
      - _sSentence: "Buongiorno, Detective\u2026 Sono Kerith, se ha biso\u2013\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6e3b74b2481e1c2428a703b2837329f7, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ef45f4e96759189439f3d192169e2e2e, type: 3}
        - {fileID: 0}
    - _sName: <color=#6b676b>Uldon</color>
      _Sentences:
      - _sSentence: "<b>Detective!</b> Mi dica che l'ha ritrovato, la prego!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 66518c072cad36846a95a41d6c52d75c, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: a90647033d929fd428c4aa5c76f44627, type: 3}
        - {fileID: 0}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "Calma, Uldon. Il Detective \xE8 appena arrivato. Se bastassero
          pochi minuti a ritrovare il Cuscino ci avremmo pensato noi stamattina,
          non credi?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 923ec003d26e5544499dbf7672e2857e, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ef45f4e96759189439f3d192169e2e2e, type: 3}
        - {fileID: 0}
    - _sName: <color=#6b676b>Uldon</color>
      _Sentences:
      - _sSentence: "Silenzio, Rhina! Non mi aspetto che tu capisca quanto disperata
          sia la situazione. Non ti rendi conto di come mi sento in questo momento?
          La mia intera vita dipende dal Sacro Cuscino!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 3f4d02db42c54774689eb7171511ed93, type: 3}
        - {fileID: 0}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ea85a70ce2edfed468ccc217e5a6aa0b, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 2937b4a9c9714c642aead35c14073d7c, type: 3}
        - {fileID: 0}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "Eleanor, tesoro, posso chiederti di andare a recuperare un bicchiere
          d'acqua? La mamma ha un po' sete, fatti accompagnare dallo zio Ker, per
          favore.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: beb0dab37c09aa3489305fd90d4c88bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 5cb4e79e72631fd4ea1530e64725de06, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 2937b4a9c9714c642aead35c14073d7c, type: 3}
        - {fileID: 0}
    _PostConditions:
      _keys: 
      _values: 
    _HasChoices: 1
    _DialogueChoices:
    - _sLabel: Stop Rhina
      _xDialogueSO: {fileID: 11400000, guid: d3528139f907b534fb83c1a2f6e5a308, type: 2}
    - _sLabel: Let her talk
      _xDialogueSO: {fileID: 11400000, guid: 933fd2e9cd99c8b4ea9406d764173ceb, type: 2}
    _HasSceneChange: 0
    _TargetSceneName: 
  hasChoices: 1
  Choices:
  - _sLabel: Stop Rhina
    _xDialogueSO: {fileID: 11400000, guid: d3528139f907b534fb83c1a2f6e5a308, type: 2}
  - _sLabel: Let her talk
    _xDialogueSO: {fileID: 11400000, guid: 933fd2e9cd99c8b4ea9406d764173ceb, type: 2}
  hasSceneChange: 0
  targetSceneName: 
