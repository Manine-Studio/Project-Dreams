%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: e65ca180d4f12aa458e72e09466aa6f3, type: 3}
    _DialogueParts:
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\u2026 Chiedo perdono se dovessi sembrare scortese, ma siete
          assolutamente sicuro che io sia la persona giusta per questo caso?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Mi conosci, B. Chiederei letteralmente a chiunque altro nel
          Dipartimento, ma...\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\u2026 Ma qualcuno lass\xF9 sta tirando i fili, che inizieranno
          a stringere molto forte attorno al vostro collo se non obbedite alla loro
          richiesta. \xC8 cos\xEC?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Dai, non fare cos\xEC! S\xEC, ci sono alcune persone che vorrebbero
          che questo caso si risolvesse il prima possibile, e queste persone POTREBBERO
          essere particolarmente vicine ad altre persone che...\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Questo lo davo per scontato, quel che ancora non mi \xE8 stato
          spiegato \xE8 il perch\xE9 dovrei essere proprio <b>IO</b> ad occuparmene.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Perch\xE9 sei il migliore, B! Lo so io, lo sai tu e a quanto
          pare lo sanno anche quei fanatici religiosi che fanno lobbismo sui nostri
          politici!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Ugh\u2026 Cos\xEC sia! Consideratelo pure un dono per il mio
          pi\xF9 caro amico.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Il tuo \"\"pi\xF9 caro amico\"\" che \xE8 anche, casualmente,
          il tuo capo?\"\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Bazzecole senza importanza, vecchio mio! Venite, discutiamo
          il briefing davanti a un bel bicchierino.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    _PostConditions:
      _keys: 
      _values: 
  hasChoices: 0
