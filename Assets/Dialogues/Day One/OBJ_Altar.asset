    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Sorprendentemente pulito, per essere un oggetto tenuto in un
          giardino. \xC8 chiaro che viene curato maniacalmente."
