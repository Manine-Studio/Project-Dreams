    _DialogueCSV: {fileID: 4900000, guid: 9633577cbfaaa91409f730f6b7f11d98, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "L\u2019altare su cui giaceva il Cuscino, presumo. Che meravigliosa
          opera, \xE8 davvero stupefacente.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Sar\xE0 meglio dare un\u2019occhiata pi\xF9 da vicino\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
