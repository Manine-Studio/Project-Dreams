  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 9633577cbfaaa91409f730f6b7f11d98, type: 3}
    _DialogueParts:
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "L'altare su cui si trovava il Cuscino, presumo. Che meravigliosa
          scultura, \xE8 davvero stupefacente.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Sar\xE0 meglio dare un'occhiata pi\xF9 da vicino\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\xC8 davvero pulito, per essere un oggetto tenuto in un giardino.
          \xC8 chiaro che viene curato maniacalmente.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Non ci sono impronte, tuttavia. Niente di rilevante.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
