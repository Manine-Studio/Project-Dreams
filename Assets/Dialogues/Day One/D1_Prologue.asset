--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_Prologue
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: b9c73aa828ec04b41999e3868ea89ae0, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "\u2026Chiedo venia se dovessi sembrare scortese, ma sei assolutamente
          sicuro che io sia la persona giusta per questo caso?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Mi conosci, Bak. Chiederei letteralmente a chiunque altro nel
          Dipartimento, ma\u2026\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "\u2026Ma qualcuno lass\xF9 sta tirando i fili, che infausta
          burla cosmica! E questi inizieranno a stringere molto forte attorno al
          vostro collo se non obbediamo alla loro richiesta. \xC8 cos\xEC?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Dai, non fare cos\xEC! S\xEC, ci sono alcune persone che vorrebbero
          che questo caso si risolvesse il prima possibile, e queste persone POTREBBERO
          essere particolarmente vicine ad altre persone che\u2026\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Questo lo davo per scontato, quel che ancora non mi \xE8 stato
          spiegato \xE8 il perch\xE9 dovrei essere proprio <b>IO</b> ad occuparmene.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Perch\xE9 sei il migliore, Bakon\xE9! Lo so io, lo sai tu e
          a quanto pare lo sanno anche quei fanatici religiosi che fanno lobbismo
          sui nostri politici!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Ugh\u2026 Cos\xEC sia! Consideratelo pure un dono per i posteri!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: ???
      _Sentences:
      - _sSentence: "Per \"posteri\" intendi il tuo capo, nonch\xE9 il tuo pi\xF9
          caro amico?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: Quisquilie, vecchio mio! Venite, discutiamo il briefing davanti
          a un bel bicchierino.
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    _PostConditions:
      _keys: 00000000
      _values: 00000000
