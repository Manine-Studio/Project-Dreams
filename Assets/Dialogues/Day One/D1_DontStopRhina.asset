    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 98a051065b626294785f4fea68c661a7, type: 3}
    _DialogueParts:
    - _sName: ' '
      _Sentences:
      - _sSentence: "<i><color=blue>[Sembrava esserci del trascorso, fra i due. L'ho
          trovato interessante, ho pensato potesse essere utile saperne di pi\xF9...]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 4bd499855be3d024789b4d2e67754f10, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: Rhina
      _Sentences:
      - _sSentence: "La stessa ragazzina che hai sempre visto come una fallita e
          che adesso sta facendo risorgere la cittadina che tuo padre ha cercato
          di vendere ai Damin per due spicci?!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ea85a70ce2edfed468ccc217e5a6aa0b, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "I miei avi hanno protetto questo villaggio per generazioni,
          Rhina! Un singolo\u2013\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
