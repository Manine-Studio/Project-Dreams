    _DialogueCSV: {fileID: 4900000, guid: ddb922a74ee75b5469df34562ab37bf6, type: 3}
    _DialogueParts:
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Lei \xE8 nata e cresciuta qui, giusto?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8bd86f3fdde132c439707a4ff5b4d923, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ac3a4bae3d9826c40aca2b80ec1b8ccf, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Io e i miei genitori, e i loro genitori prima ancora!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: c58d56ae8446b5c4d978c2e5b3164f61, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "La nostra famiglia risiede a Sleeper's Burrow praticamente da
          sempre.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Posso farle qualche domanda sugli abitanti del luogo? Immagino
          li conosciate piuttosto bene.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Ma certo! Non trover\xE0 anima viva pi\xF9 esperta di me sulle
          persone di questa citt\xE0!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
