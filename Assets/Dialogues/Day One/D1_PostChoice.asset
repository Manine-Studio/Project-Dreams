%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_PostChoice
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 2e2d8d5287b8dd9499ccd6721861a283, type: 3}
    _DialogueParts:
    - _sName: Eleanor
      _Sentences:
      - _sSentence: "Mamma! Ecco l'acqua! Vuoi anche tu una caramellina? Lo zio Ker
          ne ha rubate alcune per me dalla ciotola del Signor Uldon!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: a90647033d929fd428c4aa5c76f44627, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Kerith
      _Sentences:
      - _sSentence: "Ma... Avevi promesso di non dirlo a nessuno...\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6e3b74b2481e1c2428a703b2837329f7, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Kerith
      _Sentences:
      - _sSentence: "E comunque non le ho rubate, Signor Detective! Le ho portate
          io stesso a Uldon, sono sicuro che sar\xE0 disposto a testimoniare a mio
          favore, se...\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6e3b74b2481e1c2428a703b2837329f7, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Non si preoccupi, Dottore. Ho l'impressione che ci siano cose
          pi\xF9 importanti a cui pensare in questo momento.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: a90647033d929fd428c4aa5c76f44627, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Signori, signore e signorinelle, se non vi dispiace vorrei scambiare
          qualche parola in privato con il supervisore del Tempio.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Rhina
      _Sentences:
      - _sSentence: "Certo, Detective. Si prenda tutto il tempo che le serve, se
          dovesse avere ancora bisogno di noi pu\xF2 trovarci in citt\xE0.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 923ec003d26e5544499dbf7672e2857e, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: a90647033d929fd428c4aa5c76f44627, type: 3}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Mentre si allontanavano fra la folla ricordo
          di aver visto Kerith avvicinarsi a Rhina per parlarle, preoccupato.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Venga, Detective. Mi segua dentro, potremo parlare con pi\xF9
          calma.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
    _PostConditions:
      _keys: 
      _values: 
