  Dialogue:
    _PreConditions:
      _keys: 0c000000
      _values: 01000000
    _DialogueCSV: {fileID: 4900000, guid: 5de81fb2737068f42871584b1ddf2eda, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Lei \xE8 nata e cresciuta qui, giusto?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8bd86f3fdde132c439707a4ff5b4d923, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: e1a06d667d6d1ca4885d7570f3e4d4cd, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Io e i miei genitori, e i loro genitori prima ancora!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 926e70356b983d141af0027e8a5374ba, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "La nostra famiglia risiede a Sleeper's Burrow praticamente da
          sempre.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Posso farle qualche domanda sugli abitanti del luogo? Immagino
          li conosca piuttosto bene.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: da59ace3bb8ca1d449cfd4ce10afc64c, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Ma certo! Non trover\xE0 anima viva pi\xF9 esperta di me sulle
          persone di questa citt\xE0!"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
