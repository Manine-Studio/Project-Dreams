%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_Dinner
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: f99c65aecb84fa049b02979a5f97367f, type: 3}
    _DialogueParts:
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Quindi, cosa ne pensa, Detective? Le piace la nostra zuppa tradizionale?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Devo ammettere che aveva ragione, il sapore \xE8 davvero unico!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Le spezie si sposano alla perfezione con la carne; quando mi
          ha elencato gli ingredienti non mi aspettavo una resa cos\xEC eccellente.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "\xC8 una ricetta speciale! Qui in citt\xE0 tutti gli anziani
          la tramandano ai pi\xF9 giovani da generazioni.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Mia madre \u2014 pace all'anima sua \u2014 diceva sempre che
          questa zuppa \xE8 usata da tutta la citt\xE0, ma che la prima ad averla
          cucinata \xE8 stata una nostra trisavola.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Era una donna molto orgogliosa, sa? Nonostante tutto quello
          che ha vissuto, lei e mio padre non si sono mai arresi.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "<i><color=#34689c>[Era chiaro che si riferisse alla guerra.
          Sleeper's Burrow si trova particolarmente vicina al confine; per chiunque
          non abbia vissuto di fianco ai campi di battaglia, \xE8 difficile concepire
          ci\xF2 che hanno dovuto passare.]</color></i>\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=#34689c>[Ho pensato fosse meglio non rivangare troppo
          il passato, non volevo dare una nota amara a una cena gi\xE0 cos\xEC saporita.]</color></i>\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Signorina Lynn, qual \xE8 il vostro punto di vista su quanto
          accaduto quest'oggi?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "\xC8 una tragedia! Abbiamo perso una reliquia sacra, non so
          come Uldon si regga ancora in piedi!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Quando l'ho scoperto, ho temuto che gli fosse venuto un infarto\u2026
          Sa, \xE8 sempre stato cagionevole di salute e sicuramente la scomparsa
          non ha fatto altro che peggiorare le cose.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Prima ha menzionato il fatto che i suoi clienti hanno disdetto,
          dopo aver scoperto quanto successo?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "S\xEC, di solito le persone che si fermano a dormire sono fedeli
          che vengono in citt\xE0 per vedere il Cuscino della Dea. Alcuni hanno disdetto
          proprio perch\xE9 non possono vederlo, ma altri sono stati genuinamente
          spaventati dall'accaduto.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Pensavano che potesse succedere qualcosa anche a loro?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Esatto. Una persona che osa rubare il Cuscino della Dea non
          pu\xF2 essere qualcuno di raccomandabile, anche io ho avuto paura che qualche
          estraneo pericoloso potesse entrare nella Locanda per tutto il giorno\u2026\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Non si preoccupi, mia cara. Adesso sono qui io, dubito che il
          colpevole abbia desiderio di incontrarmi.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Anche questo \xE8 vero, spero che basti a scoraggarlo\u2026\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Le \xE8 mai capitato di nascondere reliquie sacre, in questa
          Locanda?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Non che io sappia!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: Allora non credo correremo alcun pericolo, signorina Lynn.
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    _PostConditions:
      _keys: 0c000000
      _values: 01000000
    _HasChoices: 0
    _DialogueChoices: []
    _HasSceneChange: 1
    _TargetSceneName: Locanda
    _DialogueMusicBackground: {fileID: 0}
    _LoopStartingPointInSeconds: 0
  hasChoices: 0
  Choices: []
  hasSceneChange: 1
  targetSceneName: Locanda
