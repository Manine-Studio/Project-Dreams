%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_UldonHome
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 8a74dee7a9731f8419e27d6811bdd0da, type: 3}
    _DialogueParts:
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Mi dispiace che abbiate dovuto assistere a questo increscioso
          scambio, Detective.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Ma lo sa come sono i giovani\u2026 Sempre sfrontati e senza
          rispetto, mai disposti ad ammettere le proprie colpe. Posso offrirle qualcosa?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "La ringrazio, sono apposto cos\xEC.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[La casa del Monaco era decisamente frugale,
          niente che facesse presagire una vita di vizi o eccessi. Tolto il necessario
          per vivere, non vidi nient'altro che memorabilia e santini della Dea.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Mi aveva offerto un cuscino su cui sedermi,
          mentre era andato a preprarare del t\xE9.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Lei \xE8 stato l'ultimo ad aver visto il Cuscino, corretto?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "S\xEC, esatto. Sono il monaco del Tempio della Dea del Sonno,
          prendermi cura del Cuscino della Dea fa parte dei miei compiti quotidiani.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Si ricorda quando lo ha visto l'ultima volta?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Oh\u2026 Immagino sia stato... Ieri pomeriggio, poco prima della
          chiusura del tempio?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: be9eef317efb06f48898cc905c9574d4, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "No, aspetti\u2026 Sar\xE0 stato quando ieri sera ho effettuato
          la pulizia giornaliera dell'altare!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: be9eef317efb06f48898cc905c9574d4, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Non ne \xE8 sicuro?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Beh Detective\u2026 Come posso dire\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 21300000, guid: be9eef317efb06f48898cc905c9574d4, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Ricordo chiaramente come il cos\xEC caparbio
          monaco, che fino a poco prima non aveva esitato ad aggredire una donna
          tosta come Rhina, sembrava particolarmente alle strette dopo una domanda
          cos\xEC semplice.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Era tornato da me poco dopo, portando una tazza
          di t\xE9 per s\xE9 e un'altra per me, deliberatamente ignorando la mia
          risposta alla sua domanda]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Dev'essere lo stress, ecco! Un oggetto sacro per me e per centinaia
          di credenti \xE8 appena stato rubato, penso sia normale non riuscire a
          ragionare perfettamente in un momento come questo.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Certo\u2026 Cerchiamo di ragionare insieme, allora.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Mi racconti tutta la giornata di ieri, dal momento in cui si
          \xE8 svegliato a quando \xE8 andato a dormire.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Vediamo\u2026 Mi sono svegliato presto, come sono solito fare
          ogni giorno. Dopo colazione mi sono preso del tempo per una rapida preghiera
          di fronte al Cuscino come ogni mattina, poi ho aperto il cancello del Tempio\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: f6b5ae68d18d12b49b266c503443c844, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Ricorda niente di anormale, fino a quel momento?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8114eaf73159b344896d5c5a424d72bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Nulla di nota. Anche impegnandomi, non riuscirei a trovare qualcosa
          di diverso dal solito.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: f6b5ae68d18d12b49b266c503443c844, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Capisco\u2026 Proseguiamo, allora. Cos'\xE8 successo dopo?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Di nuovo, nulla di strano: ho accolto i fedeli come ogni giorno,
          pregando con loro, raccogliendo le loro offerte e offrendo a mia volta
          cibo e bevande a coloro che le desideravano.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Qualcuno di loro le sembrava sospetto?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "No, non direi.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Nessuna conversazione peculiare? Qualcuno che ha attirato la
          sua attenzione per un motivo o per un altro?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Le conversazioni peculiari non mancano di certo, specialmente
          con alcuni residenti della citt\xE0\u2026 Ma niente di fuori dall'ordinario,
          anche qui.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: f6b5ae68d18d12b49b266c503443c844, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Presumo che lo stesso valga anche per il resto della giornata.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8114eaf73159b344896d5c5a424d72bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Esatto. Alle 20 in punto ho salutato gli ultimi fedeli, poi
          ho cenato rapidamente prima di tornare fuori e dare una ripulita, come
          ogni giorno.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: f6b5ae68d18d12b49b266c503443c844, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Ed \xE8 allora che ha visto il Cuscino per l'ultima volta?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Precisamente.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\xC8 possibile che qualcuno si sia introdotto qui di nascosto
          durante la notte? Mentre lei dormiva, magari.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Non vedo come, Detective. Ci troviamo in cima a una collina,
          ma tutto attorno al tempio c'\xE8 un precipizio scosceso. E anche se fosse
          possibile, l'intera area \xE8 circondata da mura piuttosto alte.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Uldon aveva ragione. La recinzione sembrava
          essere difficilmente superabile, persino per me.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Parliamo invece di lei, ci sono persone con cui ha rapporti
          particolarmente tesi?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8114eaf73159b344896d5c5a424d72bc, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Oh Detective, guardi, qui tutti se la prendono con me. Per\xF2
          se mi sta chiedendo se credo che qualcuno di loro abbia rubato il Cuscino
          della Dea\u2026 No, mi sembra impossibile.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: f6b5ae68d18d12b49b266c503443c844, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Per quale motivo?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Vede, pi\xF9 passa il tempo e pi\xF9 le persone si allontanano
          dai dettami della Dea\u2026 Il numero di fedeli diminuisce giorno dopo
          giorno. Queste persone non sono credenti, non hanno motivo di rubare il
          Cuscino!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Posso capire che un uomo di fede voglia rubare la nostra reliquia
          per averlo tutto per s\xE9, o un malavitoso che vuole venderlo sul mercato
          nero\u2026 Oh Santa Dea, tremo solo a pensarci.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Ma rubarlo solo per fare un dispetto a me\u2026 Mi sembra impossibile,
          sono persone che non farebbero mai una sciocchezza del genere.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Non mi sta dando molto con cui lavorare, mio caro monaco\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Non so cosa dirle, Detective! Pi\xF9 ci penso, pi\xF9 mi sembra
          impossibile che qualcuno possa averlo rubato da qui dentro.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "La Dea vede e provvede. \xC8 stata lei stessa a riprendersi
          il suo cuscino, glielo dico io!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Spero proprio lei si sbagli, sarebbe complesso da spiegare al
          mio capo.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Le dispiace se do un'occhiata al giardino? Vorrei familiarizzare
          con la scena del crimine.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Uldon
      _Sentences:
      - _sSentence: "Certo, faccia pure. Questa mattina, dopo aver saputo dell'accaduto,
          Rhina ha dato ordine di non far entrare nessuno. Dovrebbe essere tutto
          come nel momento in cui il nostro Cuscino \xE8 stato rubato.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 94ca040048fa73c46a40d3b4f5c7355b, type: 3}
        - {fileID: 0}
        - {fileID: 0}
