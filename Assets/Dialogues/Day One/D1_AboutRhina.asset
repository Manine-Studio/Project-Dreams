%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_AboutRhina
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: 21f67d0b607e3de45a545eba3b9b528b, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "<i><color=#34689c>[Rhina \xE8 il capovillaggio e sembrava avere
          un rapporto piuttosto conflittuale con Uldon. Era importante saperne di
          pi\xF9.]</color></i>\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Oh, Rhina e io siamo amiche sin da bambine!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Siamo andate a scuola insieme, \xE8 sempre stata una persona
          straordinaria\u2026 Sempre pronta a difendere i pi\xF9 deboli e aiutare
          il prossimo.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Anche se c'\xE8 da ammettere che era spesso una testa calda.
          Un bel po' di volte ha rischiato di finire a menare le mani con qualche
          professore. Credo che sia anche perch\xE9 \xE8 molto forte fisicamente.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Diceva sempre che \"se hai la fortuna di avere dei muscoli cos\xEC,
          \xE8 da stupidi non usarli\".\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "\xC8 sempre stata un'appassionata di fitness?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: e1a06d667d6d1ca4885d7570f3e4d4cd, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Oh no, non l'ho mai vista andare in palestra in vita sua! \xC8
          la sua Dote!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6ee5925e095f560458483569e1b50096, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Madame Rhina ha una Dote del genere e ha comunque scelto di
          diventare sindaca?\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 7143d44bf53b43b46a6e411870dd4164, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=#34689c>[\xC8 raro che qualcuno scelga un lavoro che
          non coinvolge almeno in parte la propria Dote, molti lo considerano uno
          spreco a tutti gli effetti.]</color></i>\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 7143d44bf53b43b46a6e411870dd4164, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "Lo so, anche noi siamo cresciuti convinti che un giorno avrebbe
          scelto un lavoro che le permettesse di sfruttare a pieno la sua forza fisica.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6ee5925e095f560458483569e1b50096, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Anche perch\xE9, come le dicevo, \xE8 sempre stata un po'\u2026
          Aggressiva.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "Ma poi, presumo, \xE8 cambiato qualcosa.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: da59ace3bb8ca1d449cfd4ce10afc64c, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: <color=#e8dd10>Lynn</color>
      _Sentences:
      - _sSentence: "In realt\xE0 non saprei dirle se c'\xE8 stato un momento preciso
          in cui Rhina \xE8 diventata diversa. Penso sia stato un cambiamento graduale.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 3541a09f31c3d5b46882ccbf600c2bfa, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Essere sempre vista come <i>la ragazza forte ma stupida</i>
          \xE8 stato duro per lei. A un certo punto ha semplicemente detto: \"Basta,
          ho deciso che le persone mi rispetteranno per il mio cervello, non per
          i miei muscoli!\"\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 3541a09f31c3d5b46882ccbf600c2bfa, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "Da quel momento in poi si \xE8 impegnata al massimo per diventare
          una persona diversa. Ha lavorato duramente, non solo per ottenere buoni
          voti ed entrare in un'universit\xE0 prestigiosa, ma anche per migliorare
          se stessa!\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "So che stamattina c'\xE8 stato un po' di attrito fra lei e Uldon,
          e forse avr\xE0 pensato che Rhina abbia esagerato a perdere la pazienza
          cos\xEC\u2026 Ma mi creda, se la conoscesse quanto la conosco io, sarebbe
          sorpreso da quanto si sia trattenuta.\r"
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6ee5925e095f560458483569e1b50096, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: Almeno per i suoi standard.
        _SFXAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 6ee5925e095f560458483569e1b50096, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    _PostConditions:
      _keys: 06000000
      _values: 01000000
    _HasChoices: 0
