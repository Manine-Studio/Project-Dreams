      _xDialogueSO: {fileID: 11400000, guid: 5fb9bcf717fcffe4cb4ebb7897d8a87a, type: 2}
    - _sLabel: Chiedi di Rhina
      _xDialogueSO: {fileID: 11400000}
    - _sLabel: Chiedi di Uldon
      _xDialogueSO: {fileID: 11400000, guid: fbfef9c530b5181438cf98ea41b4b5ba, type: 2}
    _HasSceneChange: 0
    _TargetSceneName: 
    _DialogueMusicBackground: {fileID: 0}
    _LoopStartingPointInSeconds: 0
  hasChoices: 0
  Choices:
  - _sLabel: Chiedi di Kerith
    _xDialogueSO: {fileID: 11400000, guid: 5fb9bcf717fcffe4cb4ebb7897d8a87a, type: 2}
  - _sLabel: Chiedi di Rhina
    _xDialogueSO: {fileID: 11400000}
  - _sLabel: Chiedi di Uldon
    _xDialogueSO: {fileID: 11400000, guid: fbfef9c530b5181438cf98ea41b4b5ba, type: 2}
