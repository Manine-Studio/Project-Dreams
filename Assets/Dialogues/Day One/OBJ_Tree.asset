    _DialogueCSV: {fileID: 4900000, guid: 0b8f2163dcb53804c84008ce37ad24af, type: 3}
    _DialogueParts:
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Che meraviglioso albero di glicine\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "A giudicare dalle dimensioni veglia su questo Tempio da tempo
          immemore, resistendo pazientemente al Sole accecante e alla neve imperterrita.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Ironico che sia proprio un albero di glicine a proteggere l'altare
          del Cuscino della Dea. Mi chiedo se sia stata una scelta precipua.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
