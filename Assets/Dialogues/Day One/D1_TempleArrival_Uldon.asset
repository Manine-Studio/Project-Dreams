  m_Name: D1_TempleArrival_Uldon
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 03000000
      _values: 01000000
    _DialogueCSV: {fileID: 4900000, guid: 7100344eaa1731b419535e5055db1f4a, type: 3}
    _DialogueParts:
    - _sName: "<color=#34689c>Bakon\xE9</color>"
      _Sentences:
      - _sSentence: "<i><color=#34689c>[Sembrava esserci del trascorso, fra i due.
          L'ho trovato interessante, ho pensato potesse essere utile saperne di pi\xF9\u2026]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: da59ace3bb8ca1d449cfd4ce10afc64c, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 4bd499855be3d024789b4d2e67754f10, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: <color=#c71a0e>Rhina</color>
      _Sentences:
      - _sSentence: "La stessa ragazzina che hai sempre visto come una fallita? La
          stessa che adesso sta facendo risorgere la cittadina che tuo padre ha cercato
          di vendere ai Damin per due spicci?!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ea85a70ce2edfed468ccc217e5a6aa0b, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: <color=#6b676b>Uldon</color>
      _Sentences:
      - _sSentence: "I miei avi hanno protetto questo villaggio per generazioni,
          Rhina! Un singolo\u2014"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 6c0bc5823ddca6340bcb09df0c462206, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 4bd499855be3d024789b4d2e67754f10, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 3f4d02db42c54774689eb7171511ed93, type: 3}
        - {fileID: 0}
