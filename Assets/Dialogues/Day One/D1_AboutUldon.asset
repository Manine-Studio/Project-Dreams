%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 303b5f35688ab40459c560b5d4b34fd3, type: 3}
  m_Name: D1_AboutUldon
  m_EditorClassIdentifier: 
  Dialogue:
    _PreConditions:
      _keys: 
      _values: 
    _DialogueCSV: {fileID: 4900000, guid: f5d8f27f62a059d4ca7a2936c135ee5c, type: 3}
    _DialogueParts:
    - _sName: ' '
      _Sentences:
      - _sSentence: "<i><color=blue>[Uldon, il monaco, era la persona pi\xF9 vicina
          al Cuscino della Dea. Speravo che saperne di pi\xF9 su di lui mi avrebbe
          aiutato con le indagini.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Povero Uldon\u2026 Spero stia bene.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "La scomparsa del Cuscino della Dea \xE8 stato un brutto colpo
          per tutti, ma per lui deve essere stato tragico\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Non so se Rhina le ha raccontato della famiglia di Uldon\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "No, temo non abbia avuto il tempo.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: d2a9117d83598204795419257101db38, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "La famiglia di Uldon \xE8 composta da monaci, da sempre dediti
          alla Dea e alla protezione del Cuscino sacro.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Qualche anno addietro, poco dopo l'inizio della la guerra, abbiamo
          scoperto che il padre di Uldon era in combutta con i Damin.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Aveva promesso il supporto della cittadina come punto di appoggio
          per i soldati di passaggio, offrendo loro protezione in cambio di una grossa
          quantit\xE0 di denaro.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 06e30ade1229af74c8cda1c4da50c7c3, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Presumo che il patto non fosse stato condiviso con il resto
          degli abitanti, prima dell'accordo?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: d2a9117d83598204795419257101db38, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ac3a4bae3d9826c40aca2b80ec1b8ccf, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "N\xE9 quello n\xE9 i soldi promessi, se \xE8 per quello!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: e5780b3a533cad8438f9c55ff206eef0, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Immagino che non sia pi\xF9 una figura particolarmente apprezzata
          dalla comunit\xE0.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 8bd86f3fdde132c439707a4ff5b4d923, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 03261201c88622d46ba43ed2e62281fb, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Certo, \xE8 stato bandito immediatamente e non si \xE8 pi\xF9
          fatto vedere.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Uldon ha sempre considerato il padre come un punto di riferimento,
          ma quando ha scoperto ci\xF2 che \xE8 successo \xE8 stato fra i suoi pi\xF9
          ferventi detrattori.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Ha partecipato al processo fornendo tutte le prove che ha trovato,
          \xE8 soprattutto grazie a lui che abbiamo scoperto la verit\xE0 alla fine.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Ero ancora una ragazzina quando \xE8 successo, ma credo sia
          stato il momento pi\xF9 caotico che ho mai visto in questa cittadina, insieme
          al terremoto di qualche anno fa.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Ricordo ancora le notizie di qualche anno prima.
          Un violento terremoto aveva colpito la zona e distrutto decine di edifici.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ac3a4bae3d9826c40aca2b80ec1b8ccf, type: 3}
        - {fileID: 0}
        - {fileID: 0}
      - _sSentence: "<i><color=blue>[Fra quello e la guerra, \xE8 evidente che Sleeper's
          Burrow non abbia trascorso dei bei momenti bene nel recente passato.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: ac3a4bae3d9826c40aca2b80ec1b8ccf, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Quindi il padre di Uldon, alla fine, \xE8 riuscito a scappato
          con il malloppo? O siete stati in grado di recuperare il maltolto?\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: ecb8a83ee15fcc140ace7de4ea7f6925, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Nessuno sa che fine abbiano fatto quei soldi. Quello che sappiamo
          per certo \xE8 che il padre di Uldon li aveva ottenuti dai Damin, ma dopo
          essere stato esiliato ha vissuto nella miseria e in solitudine.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Quindi quei soldi sono ancora da qualche parte, anche se dopo
          tutti questi anni abbiamo rinunciato alla ricerca.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 1c9589b0397ab2846af79d6ac370f71f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    - _sName: Lynn
      _Sentences:
      - _sSentence: "Il che \xE8 un peccato, chiss\xE0 quante cose potremmo fare
          per la cittadina se li ritrovassimo!\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 0}
        - {fileID: 21300000, guid: 36f5cad0796b28d4ba374c034bd52852, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 935cbd5ee5d91a6498f7bec71ff4218d, type: 3}
        - {fileID: 0}
        - {fileID: 0}
    _PostConditions:
      _keys: 
      _values: 
  hasChoices: 0
  TextDialogueChoiceA: 
  DialogueChoiceA: {fileID: 0}
  TextDialogueChoiceB: 
  DialogueChoiceB: {fileID: 0}
  TextDialogueChoiceC: 
  DialogueChoiceC: {fileID: 0}
