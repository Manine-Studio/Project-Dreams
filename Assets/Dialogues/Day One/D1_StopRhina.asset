    _DialogueCSV: {fileID: 4900000, guid: ee900f9f54006bd47915a2082522c8b1, type: 3}
    _DialogueParts:
    - _sName: ' '
      _Sentences:
      - _sSentence: "<i><color=blue>[Ho pensato fosse meglio intervenire, prima che
          la situazione sfuggisse di mano.]</color></i>\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 0fca24f27a7892946af3a287ce4b73ad, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Sindaca, se permette\u2026\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 0fca24f27a7892946af3a287ce4b73ad, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "Non vorrei intromettermi, ma penso sia meglio per tutti se utilizziamo
          le nostre energie per risolvere la situazione.\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 0fca24f27a7892946af3a287ce4b73ad, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
    - _sName: "Bakon\xE9"
      _Sentences:
      - _sSentence: "\xC8 importante collaborare, specialmente in questo momento,
          se vogliamo concludere al pi\xF9 presto\u2013\r"
        _sAudio: {fileID: 0}
        _sImage:
        - {fileID: 21300000, guid: 0fca24f27a7892946af3a287ce4b73ad, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 1e7e6134406d0e14793838499133f76f, type: 3}
        - {fileID: 0}
        - {fileID: 21300000, guid: 286812d7f7bb1d44b9b58a8220695d23, type: 3}
        - {fileID: 0}
